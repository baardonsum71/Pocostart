{
  "name": "pocostart",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "tsc --noEmit",
    "locales:generate": "node scripts/generate-locales.mjs",
    "prebuild:ios": "npx expo prebuild --platform ios",
    "prebuild:android": "npx expo prebuild --platform android",
    "build:ios:local": "bash scripts/ios-local-build.sh",
    "build:android:local": "bash scripts/android-local-build.sh",
    "site": "npx --yes serve website -p 4173",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-query": "^5.72.2",
    "expo": "~57.0.8",
    "expo-apple-authentication": "~57.0.1",
    "expo-constants": "~57.0.7",
    "expo-crypto": "^57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-speech": "^57.0.1",
    "expo-speech-recognition": "^56.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~3.1.0",
    "react-native-purchases": "^8.9.6",
    "react-native-purchases-ui": "^8.9.6",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-worklets": "0.10.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "^57.0.4",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "private": true
}
