EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Publishable key (sb_publishable_…) or legacy anon JWT (eyJ…) — both work in this field
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# DEVELOPMENT | PRODUCTION
EXPO_PUBLIC_CREATE_ENV=DEVELOPMENT

EXPO_PUBLIC_REVENUE_CAT_APP_STORE_API_KEY=appl_xxxxxxxx
EXPO_PUBLIC_REVENUE_CAT_PLAY_STORE_API_KEY=goog_xxxxxxxx
EXPO_PUBLIC_REVENUE_CAT_TEST_STORE_API_KEY=test_xxxxxxxx

# Entitlement identifier in RevenueCat
EXPO_PUBLIC_REVENUE_CAT_ENTITLEMENT_ID=poco start Pro
